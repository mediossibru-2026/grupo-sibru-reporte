                        <p>Mes 7-12<br>Niveles. Expansión regional.</p>
                    </div>
                </div>
            </div>

            <div class="chart-container" style="height: 300px; margin-top: 30px;">
                <div class="chart-title">Cronograma de Actividades por Fase</div>
